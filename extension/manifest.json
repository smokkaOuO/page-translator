{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "0.2.0",
  "key": "",
  "default_locale": "zh_TW",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-Dt9t4CpA.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://translation.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "commands": {
    "translate-page": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "__MSG_cmdTranslatePage__"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "__MSG_cmdTranslateSelection__"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "file:///*",
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "assets/router-CTt1sM9g.js",
        "assets/types-0FlRdA6V.js",
        "assets/i18n-CO6hAzuE.js",
        "assets/speech-MrgfOwxN.js",
        "assets/cache-CqVXcMQx.js",
        "assets/src-content-index.ts-B4kM8-jd.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
